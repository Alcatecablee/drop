# DropYourSaaS Environment Configuration Example
# Copy to .env.local or set in your hosting platform

# Supabase Public API (Accessible in browser and server)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Secret (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Bot Mitigation (Optional Cloudflare Turnstile)
TURNSTILE_SECRET_KEY=0x4AAAAAA...
VITE_TURNSTILE_SITE_KEY=0x4AAAAAA...

# Privacy-Preserving IP Hashing Salt for Submissions Moderation Queue
IP_HASH_SALT=a-very-long-random-string-used-to-salt-sha256-ip-hashes

# Canonical Site URL
VITE_SITE_URL=https://dropyoursaas.co.za
